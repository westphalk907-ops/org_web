dist/
build/
*.tsbuildinfo

# IDE
.vscode/
!.vscode/extensions.json
.idea/
.cursor/

# 日志
*.log
ai-org-dev.log

# OS
.DS_Store
Thumbs.db

# 临时文件
tmp/
temp/
*.tmp
*.bak
