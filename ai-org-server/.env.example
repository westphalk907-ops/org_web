# =====================================================================
# AI Organization 后端 - 环境变量模板
# 复制为 .env 后修改实际值
# =====================================================================

# ---- 服务 ----
NODE_ENV=development
PORT=4000

# ---- 数据库 ----
# Docker compose 默认值
DATABASE_URL="postgresql://aiorg:aiorg_dev_password@localhost:5432/aiorg?schema=public"

# ---- 鉴权 ----
# ⚠️ 生产环境必须替换！生成方法：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-random-48-byte-base64-string
JWT_EXPIRES_IN=7d

# ---- 文件上传 ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ---- CORS ----
# ⚠️ 生产环境必须改成真实部署域名，不能留 localhost
# 多个用逗号分隔，例如：https://ai-org-hub.com,https://www.ai-org-hub.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 管理后台默认账号（首次 seed 时创建）----
# ⚠️ 生产环境必须改成强密码（16+ 位，含大小写+数字+符号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-strong-password
ADMIN_EMAIL=admin@your-domain.com
