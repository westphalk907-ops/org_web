# 应用标题
VITE_APP_TITLE=AI Organization Solution Hub

# API 基础地址（后端 Express 服务）
VITE_API_BASE_URL=http://localhost:4000/api

# 上传文件静态访问地址（与后端域名保持一致）
VITE_UPLOAD_BASE=http://localhost:4000

# 埋点/分析（可选）
VITE_ANALYTICS_ID=

# 邮件服务（可选，用于自动化推送）
VITE_EMAIL_API_KEY=

# 内容 CMS（可选，使用外部 CMS 时配置）
VITE_CMS_API_URL=
VITE_CMS_API_KEY=

# ---- 上传限制（必须与后端 .env 保持一致） ----
# 普通资料文件（白皮书/Prompt/Skill/Workflow 等）单文件最大 MB
VITE_MAX_FILE_SIZE_MB=20
# 图片文件（文章封面/正文配图）单文件最大 MB
VITE_MAX_IMAGE_SIZE_MB=8
