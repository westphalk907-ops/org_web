{
  "name": "ai-org-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Organization Solution Hub - 企业 AI 组织变革的知识与解决方案中心",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vueuse/core": "^11.0.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "dompurify": "^3.1.0",
    "echarts": "^5.5.0",
    "gsap": "^3.12.5",
    "marked": "^14.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.2.0",
    "pinia-plugin-persistedstate": "^4.0.0",
    "vue": "^3.5.0",
    "vue-echarts": "^7.0.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/typography": "^0.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^6.0.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "happy-dom": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "sass": "^1.78.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
